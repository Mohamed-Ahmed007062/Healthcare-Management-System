# ---- Application Config ----
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173

# ---- Database ----
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/healthcare?retryWrites=true&w=majority
DB_CONNECT_TIMEOUT_MS=30000

# ---- Client Cors ----
CLIENT_URL=http://localhost:5173

# ---- Cryptographic Secrets (Min 32 characters long) ----
# You can generate strong keys using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_super_secret_jwt_access_token_secret_key_here_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_secret_key_here_32_chars
CSRF_SECRET=your_super_secret_csrf_token_secret_key_here_32_chars

# ---- Token Time To Live (TTL) ----
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
EMAIL_VERIFY_TTL_HOURS=24
RESET_PASSWORD_TTL_HOURS=1

# ---- Cookies ----
# Leave COOKIE_DOMAIN empty for localhost development
COOKIE_DOMAIN=
# Options: true, false (defaults to false in dev, true in prod)
COOKIE_SECURE=false

# ---- Email (SMTP Mailtrap / SendGrid) ----
# If host, port, user or pass is missing, emails will fall back to stdout terminal logs.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@healthcare-app.local

# ---- Prescription PDF ----
PRESCRIPTION_PDF_DIR=uploads/prescriptions

# ---- Telehealth Video ----
VIDEO_JOIN_WINDOW_MINUTES=15
